generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  FACULTY
  VISITOR
  HOSTEL_SUPERINTENDENT
  CONFERENCE_SUPERVISOR
  ADMIN
  GATE_SECURITY
}

enum PassType {
  STUDENT
  FACULTY
  VISITOR
  CONFERENCE_PARTICIPANT
  INVITED_VISITOR
  VEHICLE_RFID
}

enum PassStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum GateAction {
  ENTRY
  EXIT
  DENIED
}

enum ScanMethod {
  QR
  RFID
}

enum CampusStatus {
  ON_CAMPUS
  OFF_CAMPUS
}

model User {
  id              String       @id @default(uuid())
  name            String
  email           String?      @unique
  password_hash   String?
  role            Role
  phone           String       @unique
  status          CampusStatus @default(OFF_CAMPUS)
  gate_logs       GateLog[]    @relation("SecurityChecker")
  passes_applied  Pass[]       @relation("PassApplicant")
  passes_approved Pass[]       @relation("PassApprover")
  passes_held     Pass[]       @relation("PassHolder")
}

model Pass {
  id           String     @id @default(uuid())
  type         PassType
  status       PassStatus @default(PENDING)
  valid_from   DateTime
  valid_until  DateTime
  holder_id    String
  applicant_id String?
  approved_by  String?
  rfid_id      String?

  gate_logs    GateLog[]
  applicant    User?      @relation("PassApplicant", fields: [applicant_id], references: [id])
  approver     User?      @relation("PassApprover", fields: [approved_by], references: [id])
  holder       User       @relation("PassHolder", fields: [holder_id], references: [id])
  rfid_tag     RfidTag?   @relation("RFID_Pass", fields: [rfid_id], references: [id])
}

model OtpRecord {
  id         String   @id @default(uuid())
  phone      String   @unique
  otp_hash   String
  expires_at DateTime
}

model RfidTag {
  id          String       @id @default(uuid())
  tag_id      String       @unique @default(uuid())
  status      CampusStatus @default(ON_CAMPUS)
  valid_from  DateTime     @default(now())
  vehicleNum  String       @unique
  valid_until DateTime
  pass        Pass[]       @relation("RFID_Pass")
}

model GateLog {
  id         String     @id @default(uuid())
  action     GateAction
  method     ScanMethod
  timestamp  DateTime   @default(now())
  pass_id    String
  checked_by String
  security   User       @relation("SecurityChecker", fields: [checked_by], references: [id])
  pass       Pass       @relation(fields: [pass_id], references: [id])
}