// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  FACULTY
  VISITOR
}

enum PassType {
  VISITOR
  CONFERENCE_PARTICIPANT
  VEHICLE_RFID
}

enum PassStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum GateAction {
  ENTRY
  EXIT
  DENIED
}

enum ScanMethod {
  QR
  RFID
}

model User {
  id              String      @id @default(uuid())
  name            String
  email           String?     @unique
  password_hash   String?     
  role            Role
  phone           String      @unique

  passes_held     Pass[]    @relation("PassHolder")
  passes_applied  Pass[]    @relation("PassApplicant")
  passes_approved Pass[]    @relation("PassApprover")
  gate_logs       GateLog[] @relation("SecurityChecker")
}

model Pass {
  id           String     @id @default(uuid())
  type         PassType
  status       PassStatus @default(PENDING)
  valid_from   DateTime
  valid_until  DateTime

  holder_id    String
  holder       User       @relation("PassHolder", fields: [holder_id], references: [id])
  
  applicant_id String?
  applicant    User?      @relation("PassApplicant", fields: [applicant_id], references: [id])
  
  approved_by  String?
  approver     User?      @relation("PassApprover", fields: [approved_by], references: [id])

  rfid_tag     RfidTag?
  gate_logs    GateLog[]
}

model OtpRecord {
  id          String   @id @default(uuid())
  phone       String
  otp_hash    String
  expires_at  DateTime
  verified_at DateTime?
}

model RfidTag {
  id          String   @id @default(uuid())
  tag_id      String   @unique @default(uuid()) // Simulated UUID
  assigned_at DateTime @default(now())

  pass_id     String   @unique
  pass        Pass     @relation(fields: [pass_id], references: [id])
}

model GateLog {
  id         String     @id @default(uuid())
  action     GateAction
  method     ScanMethod
  timestamp  DateTime   @default(now())

  pass_id    String
  pass       Pass       @relation(fields: [pass_id], references: [id])

  checked_by String
  security   User       @relation("SecurityChecker", fields: [checked_by], references: [id])
}